
digraph GVmap {  
	label = "\n\ncaom2 data model"
	rankdir=TB
	
	node [ 
	  shape=tab
	  style=filled
	]
	subgraph cluster_packages {
	  label="Model"
	  rankdir=TB
      style=filled
      fillcolor="/set312/1"
	  
    "types" [

    URL="../caom2/types"
    label = "types"
    fillcolor="/set312/2"
    ] ;
    
	}
	
	node [
	shape=record
	fontsize=8
	style=filled] 
    "caom2:uuid"[
    URL="../caom2/uuid"
    label = "{&lt;&lt;primitive type&gt;&gt;\nuuid}"
    fillcolor="/set312/1"
    ] ;
  "caom2:ObservationIntentType" [
    URL="../caom2/ObservationIntentType"
    label = "{&lt;&lt;enumeration&gt;&gt;\nObservationIntentType|+science\l+calibration\l+outreach\l}"
    fillcolor="/set312/1"
    ] ;
  "caom2:CalibrationLevel" [
    URL="../caom2/CalibrationLevel"
    label = "{&lt;&lt;enumeration&gt;&gt;\nCalibrationLevel|+PLANNED\l+RAW_INSTRUMENTAL\l+RAW_STANDARD\l+CALIBRATED\l+PRODUCT\l+ANALYSIS_PRODUCT\l}"
    fillcolor="/set312/1"
    ] ;
  "caom2:EnergyBand" [
    URL="../caom2/EnergyBand"
    label = "{&lt;&lt;enumeration&gt;&gt;\nEnergyBand|+Radio\l+Millimeter\l+Infrared\l+Optical\l+UV\l+EUV\l+Xray\l+Gammaray\l}"
    fillcolor="/set312/1"
    ] ;
  "caom2:ReleaseType" [
    URL="../caom2/ReleaseType"
    label = "{&lt;&lt;enumeration&gt;&gt;\nReleaseType|+data\l+meta\l}"
    fillcolor="/set312/1"
    ] ;
  "caom2:PolarizationState" [
    URL="../caom2/PolarizationState"
    label = "{&lt;&lt;enumeration&gt;&gt;\nPolarizationState|+I\l+Q\l+U\l+V\l+RR\l+LL\l+RL\l+LR\l+XX\l+YY\l+XY\l+YX\l+POLI\l+FPOLI\l+POLA\l+EPOLI\l+CPOLI\l+NPOLI\l}"
    fillcolor="/set312/1"
    ] ;
  "caom2:VocabularyTerm" [
    URL="../caom2/VocabularyTerm"
    label = "{&lt;&lt;datatype&gt;&gt;\nVocabularyTerm|+namespace : ivoa:anyURI\l+term : ivoa:string\l}"
    fillcolor="/set312/1"
    ] ;
  "caom2:CalibrationStatus" [
    URL="../caom2/CalibrationStatus"
    label = "{&lt;&lt;datatype&gt;&gt;\nCalibrationStatus}"
    fillcolor="/set312/1"
    ] ;
  "caom2:Quality" [
    URL="../caom2/Quality"
    label = "{&lt;&lt;datatype&gt;&gt;\nQuality}"
    fillcolor="/set312/1"
    ] ;
  "caom2:Status" [
    URL="../caom2/Status"
    label = "{&lt;&lt;datatype&gt;&gt;\nStatus}"
    fillcolor="/set312/1"
    ] ;
  "caom2:TargetType" [
    URL="../caom2/TargetType"
    label = "{&lt;&lt;datatype&gt;&gt;\nTargetType}"
    fillcolor="/set312/1"
    ] ;
  "caom2:Tracking" [
    URL="../caom2/Tracking"
    label = "{&lt;&lt;datatype&gt;&gt;\nTracking}"
    fillcolor="/set312/1"
    ] ;
  "caom2:UCDTerm" [
    URL="../caom2/UCDTerm"
    label = "{&lt;&lt;datatype&gt;&gt;\nUCDTerm}"
    fillcolor="/set312/1"
    ] ;
  "caom2:EnergyTransition" [
    URL="../caom2/EnergyTransition"
    label = "{&lt;&lt;datatype&gt;&gt;\nEnergyTransition|+species : ivoa:string\l+transition : ivoa:string\l}"
    fillcolor="/set312/1"
    ] ;
  "caom2:Entity" [
    URL="../caom2/Entity"
    label = "{Entity|+id : caom2:uuid\l+lastModified : ivoa:datetime\l+metaChecksum : ivoa:anyURI\l+metaProducer : ivoa:anyURI\l}"
    fillcolor="/set312/1"
    ] ;
  "caom2:CaomEntity" [
    URL="../caom2/CaomEntity"
    label = "{CaomEntity|+maxLastModified : ivoa:datetime\l+accMetaChecksum : ivoa:anyURI\l}"
    fillcolor="/set312/1"
    ] ;
  "caom2:DeletedArtifactDescriptionEvent" [
    URL="../caom2/DeletedArtifactDescriptionEvent"
    label = "{DeletedArtifactDescriptionEvent|+uri : ivoa:anyURI\l}"
    fillcolor="/set312/1"
    ] ;
  "caom2:DeletedObservationEvent" [
    URL="../caom2/DeletedObservationEvent"
    label = "{DeletedObservationEvent|+uri : ivoa:anyURI\l}"
    fillcolor="/set312/1"
    ] ;
  "caom2:Observation" [
    URL="../caom2/Observation"
    label = "{Observation|+collection : ivoa:string\l+uri : ivoa:anyURI\l+uriBucket : ivoa:string\l+metaRelease : ivoa:datetime\l+sequenceNumber : ivoa:integer\l+type : ivoa:string\l+intent : caom2:ObservationIntentType\l+metaReadGroups : ivoa:anyURI\l}"
    fillcolor="/set312/1"
    ] ;
  "caom2:SimpleObservation" [
    URL="../caom2/SimpleObservation"
    label = "{SimpleObservation}"
    fillcolor="/set312/1"
    ] ;
  "caom2:DerivedObservation" [
    URL="../caom2/DerivedObservation"
    label = "{DerivedObservation|+members : ivoa:anyURI\l}"
    fillcolor="/set312/1"
    ] ;
  "caom2:Plane" [
    URL="../caom2/Plane"
    label = "{Plane|+uri : ivoa:anyURI\l+metaRelease : ivoa:datetime\l+metaReadGroups : ivoa:anyURI\l+dataRelease : ivoa:datetime\l+dataReadGroups : ivoa:anyURI\l+calibrationLevel : caom2:CalibrationLevel\l+dataProductType : ivoa:string\l}"
    fillcolor="/set312/1"
    ] ;
  "caom2:Artifact" [
    URL="../caom2/Artifact"
    label = "{Artifact|+uri : ivoa:anyURI\l+uriBucket : ivoa:string\l+productType : ivoa:string\l+releaseType : caom2:ReleaseType\l+contentType : ivoa:string\l+contentLength : ivoa:integer\l+contentChecksum : ivoa:anyURI\l+contentRelease : ivoa:datetime\l+contentReadGroups : ivoa:anyURI\l+descriptionID : ivoa:anyURI\l}"
    fillcolor="/set312/1"
    ] ;
  "caom2:ArtifactDescription" [
    URL="../caom2/ArtifactDescription"
    label = "{ArtifactDescription|+uri : ivoa:anyURI\l+description : ivoa:string\l}"
    fillcolor="/set312/1"
    ] ;
  "caom2:Algorithm" [
    URL="../caom2/Algorithm"
    label = "{Algorithm|+name : ivoa:string\l}"
    fillcolor="/set312/1"
    ] ;
  "caom2:Telescope" [
    URL="../caom2/Telescope"
    label = "{Telescope|+name : ivoa:string\l+geoLocationX : ivoa:real\l+geoLocationY : ivoa:real\l+geoLocationZ : ivoa:real\l+keywords : ivoa:string\l+trackingMode : ivoa:string\l}"
    fillcolor="/set312/1"
    ] ;
  "caom2:Instrument" [
    URL="../caom2/Instrument"
    label = "{Instrument|+name : ivoa:string\l+keywords : ivoa:string\l}"
    fillcolor="/set312/1"
    ] ;
  "caom2:Environment" [
    URL="../caom2/Environment"
    label = "{Environment|+name : ivoa:real\l+humidity : ivoa:real\l+elevation : ivoa:real\l+tau : ivoa:real\l+wavelengthTau : ivoa:real\l+ambientTemp : ivoa:real\l+photometric : ivoa:boolean\l}"
    fillcolor="/set312/1"
    ] ;
  "caom2:Proposal" [
    URL="../caom2/Proposal"
    label = "{Proposal|+id : ivoa:string\l+pi : ivoa:string\l+project : ivoa:string\l+title : ivoa:string\l+keywords : ivoa:string\l+reference : ivoa:anyURI\l}"
    fillcolor="/set312/1"
    ] ;
  "caom2:Target" [
    URL="../caom2/Target"
    label = "{Target|+name : ivoa:string\l+targetID : ivoa:anyURI\l+type : caom2:TargetType\l+redshift : ivoa:real\l+standard : ivoa:boolean\l+moving : ivoa:boolean\l+keywords : ivoa:string\l}"
    fillcolor="/set312/1"
    ] ;
  "caom2:TargetPosition" [
    URL="../caom2/TargetPosition"
    label = "{TargetPosition|+coordsys : ivoa:string\l+equinox : ivoa:real\l}"
    fillcolor="/set312/1"
    ] ;
  "caom2:Requirements" [
    URL="../caom2/Requirements"
    label = "{Requirements|+flag : caom2:Status\l}"
    fillcolor="/set312/1"
    ] ;
  "caom2:Provenance" [
    URL="../caom2/Provenance"
    label = "{Provenance|+name : ivoa:string\l+reference : ivoa:anyURI\l+version : ivoa:string\l+project : ivoa:string\l+producer : ivoa:string\l+runID : ivoa:string\l+lastExecuted : ivoa:string\l+keywords : ivoa:string\l+inputs : ivoa:anyURI\l}"
    fillcolor="/set312/1"
    ] ;
  "caom2:Observable" [
    URL="../caom2/Observable"
    label = "{Observable|+ucd : caom2:UCDTerm\l+calibration : caom2:CalibrationStatus\l}"
    fillcolor="/set312/1"
    ] ;
  "caom2:DataQuality" [
    URL="../caom2/DataQuality"
    label = "{DataQuality|+flag : caom2:Quality\l}"
    fillcolor="/set312/1"
    ] ;
  "caom2:Metrics" [
    URL="../caom2/Metrics"
    label = "{Metrics|+sourceNumberDensity : ivoa:real\l+background : ivoa:real\l+backgroundStddev : ivoa:real\l+fluxDensityLimit : ivoa:real\l+magLimit : ivoa:real\l+sampleSNR : ivoa:real\l}"
    fillcolor="/set312/1"
    ] ;
  "caom2:Position" [
    URL="../caom2/Position"
    label = "{Position|+dimension : caom2:types.Dimension2D\l+maxRecoverableScale : caom2:types.Interval\l+resolution : ivoa:real\l+resolutionBounds : caom2:types.Interval\l+sampleSize : ivoa:real\l+calibration : caom2:CalibrationStatus\l}"
    fillcolor="/set312/1"
    ] ;
  "caom2:Energy" [
    URL="../caom2/Energy"
    label = "{Energy|+bounds : caom2:types.Interval\l+energyBands : caom2:EnergyBand\l+dimension : ivoa:integer\l+resolvingPower : ivoa:real\l+resolvingPowerBounds : caom2:types.Interval\l+resolution : ivoa:real\l+resolutionBounds : caom2:types.Interval\l+sampleSize : ivoa:real\l+bandpassName : ivoa:string\l+restwav : ivoa:real\l+calibration : caom2:CalibrationStatus\l+transition : caom2:EnergyTransition\l}"
    fillcolor="/set312/1"
    ] ;
  "caom2:Time" [
    URL="../caom2/Time"
    label = "{Time|+bounds : caom2:types.Interval\l+calibration : caom2:CalibrationStatus\l+dimension : ivoa:integer\l+resolution : ivoa:real\l+resolutionBounds : caom2:types.Interval\l+sampleSize : ivoa:real\l+exposure : ivoa:real\l+exposureBounds : caom2:types.Interval\l}"
    fillcolor="/set312/1"
    ] ;
  "caom2:Polarization" [
    URL="../caom2/Polarization"
    label = "{Polarization|+states : caom2:PolarizationState\l+dimension : ivoa:integer\l}"
    fillcolor="/set312/1"
    ] ;
  "caom2:CustomAxis" [
    URL="../caom2/CustomAxis"
    label = "{CustomAxis|+ctype : ivoa:string\l+bounds : caom2:types.Interval\l+dimension : ivoa:integer\l}"
    fillcolor="/set312/1"
    ] ;
  "caom2:Visibility" [
    URL="../caom2/Visibility"
    label = "{Visibility|+distance : caom2:types.Interval\l+distributionEccentricity : ivoa:real\l+distributionFill : ivoa:real\l}"
    fillcolor="/set312/1"
    ] ;
  "caom2:types.Dimension2D" [
    URL="../caom2/types.Dimension2D"
    label = "{&lt;&lt;datatype&gt;&gt;\ntypes/Dimension2D|+naxis1 : ivoa:integer\l+naxis2 : ivoa:integer\l}"
    fillcolor="/set312/2"
    ] ;
  "caom2:types.Interval" [
    URL="../caom2/types.Interval"
    label = "{&lt;&lt;datatype&gt;&gt;\ntypes/Interval|+lower : ivoa:real\l+upper : ivoa:real\l}"
    fillcolor="/set312/2"
    ] ;
  "caom2:types.Point" [
    URL="../caom2/types.Point"
    label = "{types/Point|+cval1 : ivoa:real\l+cval2 : ivoa:real\l}"
    fillcolor="/set312/2"
    ] ;
  "caom2:types.Shape" [
    URL="../caom2/types.Shape"
    label = "{types/Shape}"
    fillcolor="/set312/2"
    ] ;
  "caom2:types.Circle" [
    URL="../caom2/types.Circle"
    label = "{types/Circle|+radius : ivoa:real\l}"
    fillcolor="/set312/2"
    ] ;
  "caom2:types.MultiShape" [
    URL="../caom2/types.MultiShape"
    label = "{types/MultiShape}"
    fillcolor="/set312/2"
    ] ;
  "caom2:types.Polygon" [
    URL="../caom2/types.Polygon"
    label = "{types/Polygon}"
    fillcolor="/set312/2"
    ] ;
  "caom2:types.IntervalM" [
    URL="../caom2/types.IntervalM"
    label = "{types/IntervalM|+lower : ivoa:real\l+upper : ivoa:real\l}"
    fillcolor="/set312/2"
    ] ;
  
 
    edge [color="red", arrowtail="none", arrowhead="empty"]
    "caom2:CalibrationStatus" -> "caom2:VocabularyTerm" ;
  "caom2:Quality" -> "caom2:VocabularyTerm" ;
  "caom2:Status" -> "caom2:VocabularyTerm" ;
  "caom2:TargetType" -> "caom2:VocabularyTerm" ;
  "caom2:Tracking" -> "caom2:VocabularyTerm" ;
  "caom2:UCDTerm" -> "caom2:VocabularyTerm" ;
  "caom2:CaomEntity" -> "caom2:Entity" ;
  "caom2:DeletedArtifactDescriptionEvent" -> "caom2:Entity" ;
  "caom2:DeletedObservationEvent" -> "caom2:Entity" ;
  "caom2:Observation" -> "caom2:CaomEntity" ;
  "caom2:SimpleObservation" -> "caom2:Observation" ;
  "caom2:DerivedObservation" -> "caom2:Observation" ;
  "caom2:Plane" -> "caom2:CaomEntity" ;
  "caom2:Artifact" -> "caom2:CaomEntity" ;
  "caom2:ArtifactDescription" -> "caom2:Entity" ;
  "caom2:types.Circle" -> "caom2:types.Shape" ;
  "caom2:types.Polygon" -> "caom2:types.Shape" ;
  
 
    edge [color="blue", arrowhead="open", arrowtail="diamond",dir="both",fontsize="10"]
    "caom2:Observation" -> "caom2:Algorithm" [headlabel="1",label="algorithm",labelfontsize=10] ;
  "caom2:Observation" -> "caom2:Telescope" [headlabel="0..1",label="telescope",labelfontsize=10] ;
  "caom2:Observation" -> "caom2:Instrument" [headlabel="0..1",label="instrument",labelfontsize=10] ;
  "caom2:Observation" -> "caom2:Environment" [headlabel="0..1",label="environment",labelfontsize=10] ;
  "caom2:Observation" -> "caom2:Proposal" [headlabel="0..1",label="proposal",labelfontsize=10] ;
  "caom2:Observation" -> "caom2:Target" [headlabel="0..1",label="target",labelfontsize=10] ;
  "caom2:Observation" -> "caom2:TargetPosition" [headlabel="0..1",label="targetPosition",labelfontsize=10] ;
  "caom2:Observation" -> "caom2:Requirements" [headlabel="0..1",label="requirements",labelfontsize=10] ;
  "caom2:Observation" -> "caom2:Plane" [headlabel="0..*",label="planes",labelfontsize=10] ;
  "caom2:Plane" -> "caom2:Observable" [headlabel="0..1",label="observable",labelfontsize=10] ;
  "caom2:Plane" -> "caom2:DataQuality" [headlabel="0..1",label="quality",labelfontsize=10] ;
  "caom2:Plane" -> "caom2:Metrics" [headlabel="0..1",label="metrics",labelfontsize=10] ;
  "caom2:Plane" -> "caom2:Position" [headlabel="0..1",label="position",labelfontsize=10] ;
  "caom2:Plane" -> "caom2:Energy" [headlabel="0..1",label="energy",labelfontsize=10] ;
  "caom2:Plane" -> "caom2:Time" [headlabel="0..1",label="time",labelfontsize=10] ;
  "caom2:Plane" -> "caom2:Polarization" [headlabel="0..1",label="polarization",labelfontsize=10] ;
  "caom2:Plane" -> "caom2:CustomAxis" [headlabel="0..1",label="custom",labelfontsize=10] ;
  "caom2:Plane" -> "caom2:Visibility" [headlabel="0..1",label="uv",labelfontsize=10] ;
  "caom2:Plane" -> "caom2:Provenance" [headlabel="0..1",label="provenance",labelfontsize=10] ;
  "caom2:Plane" -> "caom2:Artifact" [headlabel="0..*",label="artifacts",labelfontsize=10] ;
  "caom2:TargetPosition" -> "caom2:types.Point" [headlabel="1",label="coordinates",labelfontsize=10] ;
  "caom2:Position" -> "caom2:types.Shape" [headlabel="1",label="bounds",labelfontsize=10] ;
  "caom2:Position" -> "caom2:types.MultiShape" [headlabel="1",label="samples",labelfontsize=10] ;
  "caom2:Position" -> "caom2:types.Shape" [headlabel="0..1",label="minBounds",labelfontsize=10] ;
  "caom2:Energy" -> "caom2:types.IntervalM" [headlabel="1..*",label="samples",labelfontsize=10] ;
  "caom2:Time" -> "caom2:types.IntervalM" [headlabel="1..*",label="samples",labelfontsize=10] ;
  "caom2:CustomAxis" -> "caom2:types.IntervalM" [headlabel="1..*",label="samples",labelfontsize=10] ;
  "caom2:types.Circle" -> "caom2:types.Point" [headlabel="1",label="center",labelfontsize=10] ;
  "caom2:types.MultiShape" -> "caom2:types.Shape" [headlabel="1..*",label="shapes",labelfontsize=10] ;
  "caom2:types.Polygon" -> "caom2:types.Point" [headlabel="1..*",label="points",labelfontsize=10] ;
    
}
  